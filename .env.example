NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,https://secureproperties.vercel.app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_api
# Optional locally; required for production migration jobs. Keep this credential out of the app runtime.
# MIGRATION_DATABASE_URL=postgresql://migration_role:password@host:5432/database
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_TTL_SECONDS=3600
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-one-time-token-at-least-32-characters

# Optional: Daraja STK Push. Configure all fields together; never commit real credentials.
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=your-daraja-consumer-key
# MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# MPESA_SHORTCODE=your-paybill-or-till-shortcode
# MPESA_PASSKEY=your-lipa-na-mpesa-passkey
# MPESA_CALLBACK_BASE_URL=https://your-public-https-domain
# MPESA_CALLBACK_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional transactional password-recovery email (Resend). Leave disabled until a sender domain is verified.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Secure Properties <security@your-verified-domain.example>
# APP_BASE_URL=https://your-application-domain.example
